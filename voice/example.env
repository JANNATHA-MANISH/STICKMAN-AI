# Paste your real keys here, then restart the voice service.


#API KEYS:
GEMINI_API_KEY=AQ.................
INCEPTION_API_KEY=sk_.................
OPENROUTER_API_KEY=sk_q...............


# Get the Gemini key from https://aistudio.google.com/apikey
GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts
GEMINI_TTS_VOICE=Fola
GEMINI_FALLBACK_VOICE=Kore


# OpenRouter is the automatic speech fallback when Gemini is out of quota.
# Get a key from https://openrouter.ai/keys and paste it below.
OPENROUTER_BASE=https://openrouter.ai/api/v1
OPENROUTER_TTS_MODELS=heygen/heygen-voice-1-turbo:free,fish-audio/s2.1-pro-free:free


# Get the Mercury (Inception) key from https://platform.inceptionlabs.ai
MERCURY_BASE_URL=https://api.inceptionlabs.ai/v1
MERCURY_MODEL=mercury-3


# port to run
VOICE_PORT=8765
COMPANION_MODE=single
